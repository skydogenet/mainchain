/* Skydoge wallet theme: Sepia Parchment */

/* ---- base ---- */

QWidget {
    color: #4b3b2a;
    selection-background-color: #8b5e34;
    selection-color: #fbf6ea;
    outline: 0;
}

QWidget:disabled {
    color: #a8977c;
}

QMainWindow,
QDialog,
QMessageBox,
QDockWidget,
QWizard {
    background-color: #efe6cf;
}

QStackedWidget,
QScrollArea {
    background: transparent;
    border: none;
}

/* ---- frames and cards ---- */

/* StyledPanel / Box / Panel frames read as white cards on the ground */
QFrame[frameShape="1"],
QFrame[frameShape="2"],
QFrame[frameShape="6"] {
    background-color: #fbf6ea;
    border: 1px solid #e0d3b3;
    border-radius: 9px;
}

/* HLine / VLine separators become hairlines */
QFrame[frameShape="4"] {
    border: none;
    background-color: #e0d3b3;
    max-height: 1px;
}

QFrame[frameShape="5"] {
    border: none;
    background-color: #e0d3b3;
    max-width: 1px;
}

/* ---- labels ---- */

QLabel {
    background: transparent;
    border: none;
    color: #4b3b2a;
}

QLabel:disabled {
    color: #a8977c;
}

/* ---- tooltips ---- */

QToolTip {
    background-color: #4b3b2a;
    color: #efe6cf;
    border: 1px solid #4b3b2a;
    padding: 5px 8px;
}

/* ---- menu bar ---- */

QMenuBar {
    background-color: #f4ecd8;
    color: #4b3b2a;
    border-bottom: 1px solid #e0d3b3;
}

QMenuBar::item {
    background: transparent;
    padding: 6px 12px;
    border-radius: 6px;
    margin: 2px 2px;
}

QMenuBar::item:selected {
    background-color: rgba(139,94,52,10%);
    color: #8b5e34;
}

QMenuBar::item:pressed {
    background-color: rgba(139,94,52,18%);
    color: #8b5e34;
}

/* ---- menus ---- */

QMenu {
    background-color: #fbf6ea;
    color: #4b3b2a;
    border: 1px solid #e0d3b3;
    border-radius: 8px;
    padding: 5px;
}

QMenu::item {
    background: transparent;
    padding: 6px 26px 6px 14px;
    border-radius: 5px;
    margin: 1px 2px;
}

QMenu::item:selected {
    background-color: rgba(139,94,52,12%);
    color: #8b5e34;
}

QMenu::item:disabled {
    color: #a8977c;
    background: transparent;
}

QMenu::separator {
    height: 1px;
    background-color: #e0d3b3;
    margin: 5px 10px;
}

/* ---- toolbar / main navigation ---- */

QToolBar {
    background-color: #f4ecd8;
    border: none;
    border-bottom: 1px solid #e0d3b3;
    padding: 3px;
    spacing: 3px;
}

QToolBar::separator:horizontal {
    background-color: #e0d3b3;
    width: 1px;
    margin: 4px 6px;
}

QToolBar::separator:vertical {
    background-color: #e0d3b3;
    height: 1px;
    margin: 6px 4px;
}

QToolButton {
    background: transparent;
    color: #7a6853;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 7px 14px;
    margin: 1px;
}

QToolButton:hover {
    background-color: #fbf6ea;
    border: 1px solid #e0d3b3;
    color: #4b3b2a;
}

QToolButton:pressed {
    background-color: #f4ecd8;
    border: 1px solid #e0d3b3;
    color: #4b3b2a;
}

/* checkable nav tabs: the active page is clearly the accent */
QToolButton:checked {
    background-color: rgba(139,94,52,10%);
    border: 1px solid rgba(139,94,52,45%);
    color: #8b5e34;
    font-weight: 600;
}

QToolButton:checked:hover {
    background-color: rgba(139,94,52,16%);
    border: 1px solid #8b5e34;
    color: #8b5e34;
}

QToolButton:disabled {
    color: #a8977c;
    background: transparent;
    border: 1px solid transparent;
}

/* ---- push buttons ---- */

QPushButton {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #fbf6ea, stop:1 #f4ecd8);
    color: #4b3b2a;
    border: 1px solid #e0d3b3;
    border-radius: 8px;
    padding: 7px 16px;
    min-height: 16px;
}

QPushButton:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #fbf6ea, stop:1 #f4ecd8);
    border: 1px solid #a8977c;
}

QPushButton:pressed {
    background-color: #efe6cf;
    border: 1px solid #a8977c;
}

QPushButton:focus {
    border: 1px solid #8b5e34;
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #fbf6ea, stop:1 rgba(139,94,52,10%));
}

QPushButton:disabled {
    background-color: #f4ecd8;
    color: #a8977c;
    border: 1px solid #e0d3b3;
}

/* primary action */
QPushButton:default {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #a06a3a, stop:1 #8b5e34);
    color: #fbf6ea;
    border: 1px solid #8b5e34;
}

QPushButton:default:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #a06a3a, stop:1 #8b5e34);
    border: 1px solid #8b5e34;
    color: #fbf6ea;
}

QPushButton:default:pressed {
    background-color: #8b5e34;
    border: 1px solid #4b3b2a;
    color: #fbf6ea;
}

QPushButton:default:focus {
    border: 1px solid #4b3b2a;
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #a06a3a, stop:1 #8b5e34);
    color: #fbf6ea;
}

QPushButton:default:disabled {
    background-color: #f4ecd8;
    color: #a8977c;
    border: 1px solid #e0d3b3;
}

QDialogButtonBox QPushButton {
    min-width: 76px;
}

/* flat icon buttons (overview status glyph, inline helpers) keep no chrome */
QPushButton[flat="true"] {
    background: transparent;
    border: none;
    padding: 4px;
}

QPushButton[flat="true"]:hover,
QPushButton[flat="true"]:focus {
    background-color: rgba(139,94,52,10%);
    border: none;
    border-radius: 6px;
}

QPushButton[flat="true"]:pressed {
    background-color: rgba(139,94,52,18%);
    border: none;
    border-radius: 6px;
}

QPushButton[flat="true"]:disabled {
    background: transparent;
    border: none;
}

/* ---- text inputs ---- */

QLineEdit {
    background-color: #fbf6ea;
    color: #4b3b2a;
    border: 1px solid #e0d3b3;
    border-radius: 8px;
    padding: 6px 10px;
    selection-background-color: #8b5e34;
    selection-color: #fbf6ea;
}

QLineEdit:focus {
    border: 1px solid #8b5e34;
    background-color: #fbf6ea;
}

QLineEdit:read-only {
    background-color: #f4ecd8;
    color: #7a6853;
    border: 1px solid #e0d3b3;
}

QLineEdit:disabled {
    background-color: #f4ecd8;
    color: #a8977c;
    border: 1px solid #e0d3b3;
}

QTextEdit,
QPlainTextEdit {
    background-color: #fbf6ea;
    color: #4b3b2a;
    border: 1px solid #e0d3b3;
    border-radius: 8px;
    padding: 4px 6px;
    selection-background-color: #8b5e34;
    selection-color: #fbf6ea;
}

QTextEdit:focus,
QPlainTextEdit:focus {
    border: 1px solid #8b5e34;
}

QTextEdit:disabled,
QPlainTextEdit:disabled {
    background-color: #f4ecd8;
    color: #a8977c;
    border: 1px solid #e0d3b3;
}

/* ---- combo boxes ---- */

QComboBox {
    background-color: #fbf6ea;
    color: #4b3b2a;
    border: 1px solid #e0d3b3;
    border-radius: 8px;
    padding: 6px 10px;
    min-height: 16px;
    selection-background-color: #8b5e34;
    selection-color: #fbf6ea;
}

QComboBox:hover {
    border: 1px solid #a8977c;
}

QComboBox:focus,
QComboBox:on {
    border: 1px solid #8b5e34;
}

QComboBox:disabled {
    background-color: #f4ecd8;
    color: #a8977c;
    border: 1px solid #e0d3b3;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 26px;
    border-left: 1px solid #e0d3b3;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    background-color: #f4ecd8;
}

QComboBox::drop-down:hover {
    background-color: rgba(139,94,52,10%);
}

/* geometry only — the arrow glyph itself stays native (dark on light) */
QComboBox::down-arrow {
    width: 12px;
    height: 12px;
}

QComboBox QAbstractItemView {
    background-color: #fbf6ea;
    color: #4b3b2a;
    border: 1px solid #e0d3b3;
    border-radius: 6px;
    padding: 3px;
    selection-background-color: #8b5e34;
    selection-color: #fbf6ea;
    outline: 0;
}

/* ---- spin boxes ---- */

QAbstractSpinBox {
    background-color: #fbf6ea;
    color: #4b3b2a;
    border: 1px solid #e0d3b3;
    border-radius: 8px;
    padding: 6px 10px;
    selection-background-color: #8b5e34;
    selection-color: #fbf6ea;
}

QAbstractSpinBox:focus {
    border: 1px solid #8b5e34;
}

QAbstractSpinBox:disabled {
    background-color: #f4ecd8;
    color: #a8977c;
    border: 1px solid #e0d3b3;
}

QAbstractSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 20px;
    border-left: 1px solid #e0d3b3;
    border-bottom: 1px solid #e0d3b3;
    border-top-right-radius: 7px;
    background-color: #f4ecd8;
}

QAbstractSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 20px;
    border-left: 1px solid #e0d3b3;
    border-bottom-right-radius: 7px;
    background-color: #f4ecd8;
}

QAbstractSpinBox::up-button:hover,
QAbstractSpinBox::down-button:hover {
    background-color: rgba(139,94,52,10%);
}

QAbstractSpinBox::up-button:pressed,
QAbstractSpinBox::down-button:pressed {
    background-color: rgba(139,94,52,18%);
}

/* geometry only — native arrow glyphs remain legible on light ground */
QAbstractSpinBox::up-arrow,
QAbstractSpinBox::down-arrow {
    width: 9px;
    height: 9px;
}

/* ---- amount fields (monospace figures) ---- */

SkydogeAmountField QAbstractSpinBox,
BitcoinAmountField QAbstractSpinBox {
    font-family: "DejaVu Sans Mono", "Menlo", "Consolas", monospace;
    font-weight: 600;
}

/* ---- check boxes and radio buttons ---- */

QCheckBox,
QRadioButton {
    background: transparent;
    color: #4b3b2a;
    spacing: 8px;
    padding: 2px 0;
}

QCheckBox:hover,
QRadioButton:hover {
    color: #8b5e34;
}

QCheckBox:disabled,
QRadioButton:disabled {
    color: #a8977c;
}

/* size only — glyph rendering stays native; the bundled indicator
   images are dark-theme assets and are not used in this theme */
QCheckBox::indicator,
QRadioButton::indicator {
    width: 16px;
    height: 16px;
}

/* ---- group boxes ---- */

QGroupBox {
    background: transparent;
    border: 1px solid #e0d3b3;
    border-radius: 8px;
    margin-top: 16px;
    padding-top: 6px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    top: 0;
    padding: 0 4px;
    color: #7a6853;
    background: transparent;
}

/* ---- item views: tables, trees, lists ---- */

QTableView,
QTreeView,
QListView {
    background-color: #fbf6ea;
    alternate-background-color: #f4ecd8;
    color: #4b3b2a;
    border: 1px solid #e0d3b3;
    border-radius: 8px;
    gridline-color: #e0d3b3;
    selection-background-color: #8b5e34;
    selection-color: #fbf6ea;
    outline: 0;
}

QTableView::item,
QTreeView::item,
QListView::item {
    padding: 3px 4px;
    border: none;
}

QTableView::item:hover,
QTreeView::item:hover,
QListView::item:hover {
    background-color: rgba(139,94,52,8%);
}

QTableView::item:selected,
QTreeView::item:selected,
QListView::item:selected {
    background-color: #8b5e34;
    color: #fbf6ea;
}

QTableView:disabled,
QTreeView:disabled,
QListView:disabled {
    color: #a8977c;
    alternate-background-color: #f4ecd8;
}

QTableView QTableCornerButton::section {
    background-color: #f4ecd8;
    border: none;
    border-right: 1px solid #e0d3b3;
    border-bottom: 1px solid #e0d3b3;
}

/* ---- header sections ---- */

QHeaderView {
    background-color: #f4ecd8;
    border: none;
}

QHeaderView::section {
    background-color: #f4ecd8;
    color: #7a6853;
    border: none;
    border-right: 1px solid #e0d3b3;
    border-bottom: 1px solid #e0d3b3;
    padding: 6px 10px;
    font-weight: 600;
}

QHeaderView::section:hover {
    background-color: #f4ecd8;
    color: #4b3b2a;
}

QHeaderView::section:last {
    border-right: none;
}

/* ---- tabs ---- */

QTabWidget::pane {
    background-color: #fbf6ea;
    border: 1px solid #e0d3b3;
    border-radius: 8px;
    top: -1px;
}

QTabBar::tab {
    background-color: #f4ecd8;
    color: #7a6853;
    border: 1px solid #e0d3b3;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 7px 16px;
    margin-right: 2px;
}

QTabBar::tab:hover {
    background-color: #f4ecd8;
    color: #4b3b2a;
}

QTabBar::tab:selected {
    background-color: #fbf6ea;
    color: #8b5e34;
    border: 1px solid #e0d3b3;
    border-top: 2px solid #8b5e34;
    border-bottom: none;
    font-weight: 600;
}

QTabBar::tab:!selected {
    margin-top: 3px;
}

/* ---- scroll bars ---- */

QScrollBar:vertical {
    background-color: #f4ecd8;
    width: 12px;
    margin: 0;
    border: none;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background-color: #e0d3b3;
    border-radius: 4px;
    margin: 2px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background-color: #a8977c;
}

QScrollBar::handle:vertical:pressed {
    background-color: #a8977c;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
    width: 0;
    background: none;
    border: none;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background-color: #f4ecd8;
    height: 12px;
    margin: 0;
    border: none;
    border-radius: 6px;
}

QScrollBar::handle:horizontal {
    background-color: #e0d3b3;
    border-radius: 4px;
    margin: 2px;
    min-width: 28px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #a8977c;
}

QScrollBar::handle:horizontal:pressed {
    background-color: #a8977c;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    height: 0;
    width: 0;
    background: none;
    border: none;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
}

/* ---- progress bars ---- */

QProgressBar {
    background-color: #f4ecd8;
    color: #4b3b2a;
    border: 1px solid #e0d3b3;
    border-radius: 8px;
    text-align: center;
    min-height: 16px;
}

QProgressBar::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #a06a3a, stop:1 #8b5e34);
    border-radius: 7px;
    margin: 1px;
}

/* ---- sliders ---- */

QSlider {
    background: transparent;
    min-height: 22px;
}

QSlider::groove:horizontal {
    background-color: #e0d3b3;
    height: 4px;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background-color: #8b5e34;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background-color: #fbf6ea;
    border: 1px solid #a8977c;
    width: 16px;
    height: 16px;
    margin: -6px 0;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    border: 1px solid #8b5e34;
    background-color: rgba(139,94,52,10%);
}

QSlider::groove:vertical {
    background-color: #e0d3b3;
    width: 4px;
    border-radius: 2px;
}

QSlider::sub-page:vertical {
    background-color: #8b5e34;
    border-radius: 2px;
}

QSlider::handle:vertical {
    background-color: #fbf6ea;
    border: 1px solid #a8977c;
    width: 16px;
    height: 16px;
    margin: 0 -6px;
    border-radius: 8px;
}

QSlider::handle:vertical:hover {
    border: 1px solid #8b5e34;
    background-color: rgba(139,94,52,10%);
}

/* ---- splitters ---- */

QSplitter::handle {
    background-color: #e0d3b3;
}

QSplitter::handle:horizontal {
    width: 4px;
}

QSplitter::handle:vertical {
    height: 4px;
}

QSplitter::handle:hover {
    background-color: rgba(139,94,52,35%);
}

/* ---- status bar ---- */

QStatusBar {
    background-color: #f4ecd8;
    color: #7a6853;
    border-top: 1px solid #e0d3b3;
}

QStatusBar::item {
    border: none;
}

QStatusBar QLabel {
    color: #7a6853;
    background: transparent;
}

/* ---- overview page balance polish ---- */

QLabel#labelBalance,
QLabel#labelUnconfirmed,
QLabel#labelImmature,
QLabel#labelTotal,
QLabel#labelWatchAvailable,
QLabel#labelWatchPending,
QLabel#labelWatchImmature,
QLabel#labelWatchTotal {
    font-family: "DejaVu Sans Mono", "Menlo", "Consolas", monospace;
    font-weight: 600;
    color: #4b3b2a;
}

QLabel#labelTotal,
QLabel#labelWatchTotal {
    color: #5c7a2f;
}

QLabel#labelImmature,
QLabel#labelWatchImmature {
    color: #9c6b3f;
}

QLabel#labelBalanceText,
QLabel#labelPendingText,
QLabel#labelImmatureText,
QLabel#labelTotalText {
    color: #7a6853;
}

/* network warning banner at the top of the overview page */
QLabel#labelAlerts {
    background-color: rgba(176,71,47,8%);
    color: #b0472f;
    border: 1px solid rgba(176,71,47,30%);
    border-radius: 7px;
    padding: 6px 10px;
}

QLabel#labelUSDBTC,
QLabel#labelUSDBTCTotal {
    color: #9c6b3f;
}

/* ---- misc ---- */

QSizeGrip {
    background: transparent;
    width: 12px;
    height: 12px;
}

QToolBox::tab {
    background-color: #f4ecd8;
    color: #7a6853;
    border: 1px solid #e0d3b3;
    border-radius: 6px;
    padding: 5px;
}

QToolBox::tab:selected {
    background-color: rgba(139,94,52,10%);
    color: #8b5e34;
}

/* ============================================================
   ==== Redesign ====
   New UI: overview balance cards, left navigation rail, brand
   header, live footer, sync progress line, custom title bar.
   Midnight Money palette translated to the Light palette.
   ============================================================ */

/* ---- Overview page: card layout ---- */

/* Balance "hero" card wrapping the balance grid */
QFrame#cardBalance {
    background-color: #fbf6ea;
    border: 1px solid #e0d3b3;
    border-radius: 14px;
    padding: 22px;
}

/* News + mempool/blocks sections as cards */
#OverviewPage QFrame#frame_2,
#OverviewPage QFrame#frame_3 {
    background-color: #fbf6ea;
    border: 1px solid #e0d3b3;
    border-radius: 14px;
    padding: 18px;
}

/* "TOTAL BALANCE" eyebrow above the balance */
QLabel#labelTotalEyebrow {
    color: #7a6853;
    font-size: 11px;
    font-weight: bold;
}

/* Hero balance number — large, money-green (the Total is the hero) */
QLabel#labelTotal {
    font-size: 30px;
    color: #5c7a2f;
}

/* Fiat estimate in blue */
QLabel#labelUSDBTCTotal {
    color: #9c6b3f;
    font-weight: bold;
    font-family: "DejaVu Sans Mono", "Menlo", "Consolas", monospace;
}

/* Section header labels on the overview page */
#OverviewPage QLabel#label_5,
#OverviewPage QLabel#label_3,
#OverviewPage QLabel#label,
#OverviewPage QLabel#label_2 {
    font-weight: bold;
    font-size: 14px;
    color: #4b3b2a;
}

/* ---- Left navigation rail (the tabs toolbar) ---- */

QToolBar#navToolbar {
    background-color: #f4ecd8;
    border: none;
    border-right: 1px solid #e0d3b3;
    padding: 16px 10px;
    spacing: 4px;
    min-width: 184px;
}

QToolBar#navToolbar QToolButton {
    background: transparent;
    border: none;
    border-left: 3px solid transparent;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    color: #7a6853;
    font-size: 13px;
    font-weight: 500;
    padding: 11px 16px;
    min-width: 150px;
    text-align: left;
}

QToolBar#navToolbar QToolButton:hover {
    background-color: rgba(0,0,0,5%);
    color: #4b3b2a;
}

QToolBar#navToolbar QToolButton:checked {
    background-color: rgba(139,94,52,12%);
    border-left: 3px solid #8b5e34;
    color: #8b5e34;
}

QToolBar#navToolbar::separator {
    background-color: #e0d3b3;
    height: 1px;
    margin: 8px 8px;
}

QToolBar#navToolbar QToolButton::menu-indicator {
    image: none;
}

/* Nav rail brand header + status dots */
QWidget#navHeader {
    background: transparent;
}

QLabel#navBrand {
    color: #4b3b2a;
    font-size: 18px;
    font-weight: bold;
    padding-left: 2px;
}

QLabel#navVersion {
    color: #a8977c;
    font-family: "DejaVu Sans Mono", "Menlo", "Consolas", monospace;
    font-size: 10px;
    padding-left: 2px;
}

/* Bottom status-bar left cluster */
QLabel#statusDot {
    color: #5c7a2f;
    font-size: 11px;
}
QLabel#statusInfoLabel {
    color: #7a6853;
    font-size: 11px;
}

QLabel#navDot1 { color: #b0472f; font-size: 13px; }
QLabel#navDot2 { color: #9c6b3f; font-size: 13px; }
QLabel#navDot3 { color: #5c7a2f; font-size: 13px; }

/* Left rail live footer (block height + peers/synced) */
QWidget#navFooter {
    background: transparent;
}
QLabel#navFooterBlock {
    color: #5c7a2f;
    font-family: "DejaVu Sans Mono", "Menlo", "Consolas", monospace;
    font-size: 11px;
    font-weight: bold;
}
QLabel#navFooterPeers {
    color: #7a6853;
    font-family: "DejaVu Sans Mono", "Menlo", "Consolas", monospace;
    font-size: 11px;
}

/* Status-bar sync progress line (right side) */
QProgressBar#syncProgressBar {
    background-color: #f4ecd8;
    border: 1px solid #e0d3b3;
    border-radius: 7px;
    text-align: center;
    color: #4b3b2a;
    font-size: 9px;
}
QProgressBar#syncProgressBar::chunk {
    background-color: #8b5e34;
    border-radius: 6px;
}

/* ---- Custom frameless title bar ---- */

QWidget#titleBar {
    background-color: #f4ecd8;
    border-bottom: 1px solid #e0d3b3;
}

QLabel#titleBarLabel {
    color: #4b3b2a;
    font-size: 13px;
    font-weight: bold;
}

QLabel#networkBadge {
    color: #8b5e34;
    font-family: "DejaVu Sans Mono", "Menlo", "Consolas", monospace;
    font-size: 11px;
    font-weight: bold;
    border: 1px solid rgba(139,94,52,35%);
    border-radius: 5px;
    padding: 3px 9px;
}
